---
import '@/styles/global.css';
import { mediaFor, mediaInfo, navigation } from '@/data/navigation';
import SiteMenu from '@/components/SiteMenu.astro';
interface Props {
  title: string;
  description: string;
  immersive?: boolean;
}
const { title, description, immersive = false } = Astro.props;
const media = mediaFor(Astro.url.pathname);
const identity = mediaInfo[media];
const fullTitle =
  title === identity.name || title.endsWith('｜' + identity.name)
    ? title
    : title + ' | ' + identity.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    />
    <meta name="description" content={description} /><meta
      name="theme-color"
      content="#171b1c"
    />
    <link rel="canonical" href={canonical} /><link
      rel="icon"
      href="/favicon.svg"
      type="image/svg+xml"
    />
    <link
      rel="preload"
      href="/fonts/anton.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link rel="preload" href="/life-atlas-logo.svg" as="image" />
    <meta property="og:type" content="website" /><meta
      property="og:locale"
      content="ja_JP"
    />
    <meta property="og:title" content={fullTitle} /><meta
      property="og:description"
      content={description}
    />
    <meta property="og:url" content={canonical} /><meta
      name="twitter:card"
      content="summary"
    />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <header
      class:list={['atlas-header', { 'atlas-header--overlay': immersive }]}
    >
      <a
        class="atlas-brand"
        href={identity.home}
        aria-label={identity.name + ' トップ'}
        style={immersive ? 'filter:brightness(0) invert(1)' : undefined}
      >
        {
          media === 'portal' ? (
            <img
              src="/life-atlas-logo.svg"
              alt="Life Atlas"
              width="700"
              height="219"
              style="display:block;width:clamp(128px,14vw,188px);height:auto"
            />
          ) : (
            <span class="media-brand">
              <>
                <strong>{identity.name}</strong>
                <small>by Life Atlas</small>
              </>
            </span>
          )
        }
      </a>
      <SiteMenu {immersive} />
    </header>
    <main id="main-content"><slot /></main>
    <footer
      class:list={['atlas-footer', { 'atlas-footer--minimal': immersive }]}
    >
      <a
        class="footer-wordmark"
        href="/"
        aria-label="Life Atlas トップ"
        style={immersive ? 'filter:brightness(0) invert(1)' : undefined}
      >
        <img
          src="/life-atlas-logo.svg"
          alt="Life Atlas"
          width="700"
          height="219"
          loading="lazy"
          style="display:block;width:150px;height:auto"
        />
      </a>
      <nav aria-label="フッターナビゲーション">
        {
          navigation[media].map((item) => (
            <a href={item.href}>
              {item.label === 'ビールが美味しい店・認定店検索'
                ? 'Beer Atlas'
                : item.label}
            </a>
          ))
        }
        {media !== 'portal' && <a href="/">Life Atlasについて</a>}
        <a href="/site-policy/">サイトポリシー</a>
      </nav>
      <small>© {new Date().getFullYear()} Life Atlas</small>
    </footer>
  </body>
</html>
