---
import '@/styles/global.css';
interface Props {
  title: string;
  description: string;
  immersive?: boolean;
}
const { title, description, immersive = false } = Astro.props;
const fullTitle = title === 'Life Atlas' ? title : title + ' | Life Atlas';
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    />
    <meta name="description" content={description} /><meta
      name="theme-color"
      content="#171b1c"
    />
    <link rel="canonical" href={canonical} /><link
      rel="icon"
      href="/favicon.svg"
      type="image/svg+xml"
    />
    <link
      rel="preload"
      href="/fonts/anton.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link rel="preload" href="/life-atlas-logo.svg" as="image" />
    <meta property="og:type" content="website" /><meta
      property="og:locale"
      content="ja_JP"
    />
    <meta property="og:title" content={fullTitle} /><meta
      property="og:description"
      content={description}
    />
    <meta property="og:url" content={canonical} /><meta
      name="twitter:card"
      content="summary"
    />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <header
      class:list={['atlas-header', { 'atlas-header--overlay': immersive }]}
    >
      <a
        class="atlas-brand"
        href="/"
        aria-label="Life Atlas トップ"
        style={immersive ? 'filter:brightness(0) invert(1)' : undefined}
      >
        <img
          src="/life-atlas-logo.svg"
          alt="Life Atlas"
          width="700"
          height="219"
          style="display:block;width:clamp(128px,14vw,188px);height:auto"
        />
      </a>
      <nav aria-label="メインナビゲーション">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}
          >地域を選ぶ</a
        >
        <a
          href="/niigata/"
          aria-current={path.startsWith('/niigata') ? 'true' : undefined}
          >新潟</a
        >
        <a
          href="/hakodate/"
          aria-current={path.startsWith('/hakodate') ? 'true' : undefined}
          >函館</a
        >
      </nav>
    </header>
    <main id="main-content"><slot /></main>
    <footer
      class:list={['atlas-footer', { 'atlas-footer--minimal': immersive }]}
    >
      <a
        class="footer-wordmark"
        href="/"
        aria-label="Life Atlas トップ"
        style={immersive ? 'filter:brightness(0) invert(1)' : undefined}
      >
        <img
          src="/life-atlas-logo.svg"
          alt="Life Atlas"
          width="700"
          height="219"
          loading="lazy"
          style="display:block;width:150px;height:auto"
        />
      </a>
      <nav aria-label="フッターナビゲーション">
        <a href="/niigata/">新潟</a><a href="/hakodate/">函館</a><a
          href="/niigata/map/">新潟の地図</a
        >
      </nav>
      <small>© {new Date().getFullYear()} Life Atlas</small>
    </footer>
  </body>
</html>
