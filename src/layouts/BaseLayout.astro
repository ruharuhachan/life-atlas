---
import ProjectOrb from '@/components/ProjectOrb.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const fullTitle = title === 'Life Atlas' ? title : title + ' | Life Atlas';
const canonical = new URL(Astro.url.pathname, Astro.site);
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Life Atlas',
  url: new URL('/', Astro.site).href,
  description: '暮らす場所を、感覚だけで決めないための地域生活メディア。',
  inLanguage: 'ja-JP',
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#173c3a" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>{fullTitle}</title>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(websiteJsonLd)}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="brand" href="/" aria-label="Life Atlas トップ">
          <span class="brand__mark" aria-hidden="true">L</span>
          <span>
            <strong>LIFE ATLAS</strong>
            <small>暮らしの解像度を上げる</small>
          </span>
        </a>
        <nav aria-label="メインナビゲーション">
          <a href="/niigata/">新潟</a>
          <a href="/niigata/housing/">住まい</a>
          <a href="/niigata/food/">食</a>
          <a href="/niigata/support/">支援制度</a>
        </nav>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell site-footer__grid">
        <div>
          <p class="eyebrow">LIFE ATLAS</p>
          <h2>移住を、解像度の高い選択に。</h2>
        </div>
        <div class="site-footer__links">
          <a href="/niigata/">新潟を知る</a>
          <a href="https://ruharuhachan.github.io/niigata-pairing-lab/"
            >ペアリングラボ</a
          >
          <a href="https://ruharuhachan.github.io/niigata-mansion-compare/"
            >マンション比較</a
          >
        </div>
      </div>
      <div class="shell site-footer__bottom">
        <p>制度・価格・営業時間は、必ず各公式情報もご確認ください。</p>
        <p>© {new Date().getFullYear()} Life Atlas</p>
      </div>
    </footer>
    <ProjectOrb />
  </body>
</html>
