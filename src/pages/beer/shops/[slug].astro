---
import BaseLayout from '@/layouts/BaseLayout.astro';
import brands from '@/data/beer/brands.json';
import shops from '@/data/beer/shops.json';
import makers from '@/data/beer/manufacturers.json';
import certifications from '@/data/beer/certifications.json';
import {
  isAffiliateReservation,
  reservationHref,
  reservationRel,
} from '@/data/beer/reservations';
import '@/styles/beer.css';
import '@/styles/beer-reservations.css';

export function getStaticPaths() {
  return shops.map((shop) => ({
    params: { slug: shop.slug },
    props: { shop },
  }));
}

const { shop } = Astro.props;
---

<BaseLayout
  title={`${shop.name} — Beer Atlas`}
  description="実店舗のビール提供情報。メーカーの認定・提供区分と外部口コミを分けて掲載。"
>
  <article class="beer-document">
    <a href="/beer/">← ビールの店舗検索へ</a>
    <p class="beer-kicker">BEER ATLAS / SHOP GUIDE</p>
    <h1>{shop.name}</h1>
    <div class="beer-notice">
      実店舗の掲載情報です。提供状況や営業時間は変更されることがあるため、来店前に掲載元・店舗情報をご確認ください。
    </div>
    <p>{shop.address}</p>

    <h2>メーカー・銘柄・提供品質</h2>
    <p>{makers.find((m) => m.id === shop.manufacturerId)?.name}</p>
    <div class="beer-tags">
      {
        shop.brandIds.map((id) => (
          <span>{brands.find((b) => b.id === id)?.name}</span>
        ))
      }
      {
        shop.certifications.map((id) => (
          <span>{certifications.find((c) => c.id === id)?.name}</span>
        ))
      }
    </div>
    <ul>
      {
        shop.certifications.map((id) => {
          const c = certifications.find((c) => c.id === id);
          return (
            c && (
              <li>
                <a href={c.officialSourceUrl} target="_blank" rel="noreferrer">
                  {c.name}のメーカー公式情報 ↗
                </a>
              </li>
            )
          );
        })
      }
    </ul>
    <p>
      エクストラコールドはメーカー認定の加点ではなく、確認できた提供区分として表示しています。店舗の品質認定とは分けて扱います。
    </p>

    <h2>ネット予約</h2>
    {
      shop.reservationLinks.length > 0 ? (
        <>
          <div class="beer-reservation-links">
            {shop.reservationLinks.map((link) => (
              <a
                class="beer-reservation-button"
                href={reservationHref(link)}
                target="_blank"
                rel={reservationRel(link)}
              >
                <span>{link.label}で予約</span>
                <span>
                  {isAffiliateReservation(link) && (
                    <small class="beer-ad-label">広告</small>
                  )}
                  ↗
                </span>
              </a>
            ))}
          </div>
          <p class="beer-affiliate-note">
            予約リンクにはアフィリエイトリンクを含む場合があります。掲載順位や評価には影響しません。
          </p>
        </>
      ) : (
        <p>ネット予約は未確認です。</p>
      )
    }

    <h2>評価情報</h2>
    <div class="beer-table-wrap">
      <table>
        <thead>
          <tr><th>項目</th><th>状態</th></tr>
        </thead>
        <tbody>
          <tr>
            <th>Google口コミ</th>
            <td>
              <a href={shop.googleMapsUrl} target="_blank" rel="noreferrer">
                Google Mapsで口コミを見る ↗
              </a>
            </td>
          </tr>
          <tr><th>サーバー・衛生管理</th><td>{shop.controls.server}</td></tr>
          <tr><th>グラス管理</th><td>{shop.controls.glass}</td></tr>
          <tr><th>温度・提供区分</th><td>{shop.controls.temperature}</td></tr>
          <tr><th>メニュー・価格の公開</th><td>{shop.controls.menu}</td></tr>
          <tr>
            <th>ネット予約</th>
            <td>{shop.reservationLinks.length > 0 ? '可' : '未確認'}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p>
      Google口コミの点数・件数はBeer Atlas内に取得・保存せず、Google
      Mapsへの外部リンクとして案内します。未確認は不適合を意味しません。
    </p>
    <a href="/beer/methodology/">評価基準を確認する ↗</a>

    <h2>出典・確認日</h2>
    <p>最終確認日：{shop.lastVerifiedAt ?? '未確認'}</p>
    <ul>
      {
        shop.sources.map((source) => (
          <li>
            <a href={source.url} target="_blank" rel="noreferrer">
              {source.label} ↗
            </a>
          </li>
        ))
      }
    </ul>

    {
      shop.articleSlug && (
        <>
          <h2>編集部の記事</h2>
          <p>
            客観指標とは別に、店の雰囲気や一杯の体験を伝える記事を掲載します。
          </p>
          <a class="beer-button" href={`/beer/articles/${shop.articleSlug}/`}>
            記事を読む ↗
          </a>
        </>
      )
    }
  </article>
</BaseLayout>
