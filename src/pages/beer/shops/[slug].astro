---
import BaseLayout from '@/layouts/BaseLayout.astro';
import shops from '@/data/beer/shops.json';
import makers from '@/data/beer/manufacturers.json';
import certifications from '@/data/beer/certifications.json';
import '@/styles/beer.css';
export function getStaticPaths() {
  return shops.map((shop) => ({
    params: { slug: shop.slug },
    props: { shop },
  }));
}
const { shop } = Astro.props;
---

<BaseLayout
  title={`${shop.name}（サンプル）`}
  description="架空店舗によるビールガイドの評価・詳細表示サンプル。"
>
  <article class="beer-document">
    <a href="/beer/">← ビールの店舗検索へ</a><p class="beer-kicker">
      BEER ATLAS / SHOP GUIDE
    </p><h1>{shop.name}</h1><div class="beer-notice">
      この店舗・所在地・認定・口コミ点数は架空のサンプルです。実在店の営業情報や評価ではありません。
    </div><p>{shop.address}</p><h2>メーカー・提供品質</h2><p>
      {makers.find((m) => m.id === shop.manufacturerId)?.name}
    </p><div class="beer-tags">
      {
        shop.certifications.map((id) => (
          <span>{certifications.find((c) => c.id === id)?.name}</span>
        ))
      }
    </div><p>
      制度名と各社の正式な認定条件の対応は、公式情報の確認後に掲載します。特別な温度での提供と、店舗の品質認定は別の情報です。
    </p><h2>評価情報</h2><div class="beer-table-wrap">
      <table>
        <thead><tr><th>項目</th><th>状態</th></tr></thead><tbody
          ><tr
            ><th>店舗全体の口コミ（サンプル）</th><td
              >{shop.externalRatings.google.score?.toFixed(1) ?? '未取得'} / 5</td
            ></tr
          ><tr><th>実際のGoogle評価・件数・取得日</th><td>未取得</td></tr><tr
            ><th>サーバー・衛生管理</th><td>未確認</td></tr
          ><tr><th>グラス管理</th><td>未確認</td></tr><tr
            ><th>温度・ガス圧・注ぎ方</th><td>未確認</td></tr
          ><tr><th>メニュー・価格の公開</th><td>{shop.controls.menu}</td></tr
          ><tr
            ><th>ネット予約</th><td
              >{shop.reservationAvailable ? '可（サンプル）' : '未確認'}</td
            ></tr
          ></tbody
        >
      </table>
    </div><p>
      未確認は不適合を意味しません。予約手段は利便性の情報として扱い、ビール品質の評価には加算しません。
    </p><a href="/beer/methodology/">評価基準を確認する ↗</a><h2>
      出典・確認日
    </h2><p>
      出典：なし（デモデータ）<br />最終確認日：未確認<br
      />公式サイト・予約先：未登録
    </p>{
      shop.articleSlug && (
        <>
          <>
            <h2>編集部の記事</h2>
            <p>
              客観指標とは別に、店の雰囲気や一杯の体験を伝える記事を掲載します。
            </p>
            <a class="beer-button" href={`/beer/articles/${shop.articleSlug}/`}>
              記事表示のサンプルを読む ↗
            </a>
          </>
        </>
      )
    }
  </article>
</BaseLayout>
