---
import { topics, type Topic } from '@/data/topics';
import BaseLayout from '@/layouts/BaseLayout.astro';
import RegionNav from '@/components/RegionNav.astro';
export function getStaticPaths() {
  return topics
    .filter((t) => ['work', 'run'].includes(t.slug))
    .map((topic) => ({ params: { topic: topic.slug }, props: { topic } }));
}
interface Props {
  topic: Topic;
}
const { topic } = Astro.props;
---

<BaseLayout title={topic.label + '｜新潟'} description={topic.description}>
  <RegionNav />
  <div class="page-heading">
    <div>
      <p class="eyebrow">NIIGATA / {topic.english}</p><h1>{topic.label}</h1>
    </div><p>{topic.lead}</p>
  </div>
  <section class="section shell">
    <div class="city-areas">
      {
        topic.points.map((point, i) => (
          <article>
            <>
              <span>0{i + 1}</span>
              <h3>{point.title}</h3>
              <p>{point.description}</p>
            </>
          </article>
        ))
      }
    </div><div class="link-rows">
      <a class="link-row" href="/niigata/map/"
        ><span
          ><strong>生活地図で街を見る</strong><small
            >住まいと店の位置関係を確認。</small
          ></span
        ><span>↗</span></a
      ><a class="link-row" href="/niigata/relocation/"
        ><span
          ><strong>移住の準備をする</strong><small
            >仕事・移動・支援制度の確認へ。</small
          ></span
        ><span>↗</span></a
      >
    </div>
  </section>
</BaseLayout>
