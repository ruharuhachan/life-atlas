---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RegionNav from '@/components/RegionNav.astro';
import HousingApp from '@/legacy/housing/HousingApp';
import '@/styles/legacy-tools.css';
import '@/styles/tool-refinements.css';
---

<BaseLayout
  title="新潟のマンション比較"
  description="新潟の31住戸の観測記録、価格と面積の散布図、自分の候補比較、月額試算。保存済みの候補も継続して使えます。"
>
  <RegionNav active="/niigata/housing/" />
  <div class="page-heading">
    <div>
      <p class="eyebrow">NIIGATA / FIND YOUR HOME</p><h1>住まいを選ぶ。</h1>
    </div><a class="text-link" href="/niigata/map/?category=housing"
      >マンションを地図で見る ↗</a
    >
  </div>
  <div class="legacy-tool housing-tool"><HousingApp client:load /></div>
</BaseLayout>
