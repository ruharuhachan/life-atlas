---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RegionNav from '@/components/RegionNav.astro';
import { regions } from '@/data/regions';
const r = regions[0];
---

<BaseLayout
  title="新潟"
  description="新潟の食と住まいを、地図からつなぐ。飲食店7店、マンション31住戸の観測記録と34地点の生活地図。"
>
  <section class="region-cover">
    <img
      src={r.image}
      alt={r.alt}
      fetchpriority="high"
      style={'object-position:' + r.position}
    /><div class="region-cover-copy">
      <p class="eyebrow">NIIGATA CITY, JAPAN</p><h1>NIIGATA</h1><p>{r.title}</p>
    </div><a
      class="photo-credit"
      href={r.source}
      target="_blank"
      rel="noreferrer">PHOTO: {r.credit} / Unsplash</a
    >
  </section>
  <RegionNav active="/niigata/" />
  <section class="section shell">
    <div class="section-head">
      <div>
        <p class="eyebrow">THE WAY WE LIVE</p><h2>
          この街を、<br />食と住まいから。
        </h2>
      </div><p>
        一軒の店と、ひとつの住まい。<br
        />行きたい場所を重ねると、新潟での毎日が見えてくる。
      </p>
    </div>
    <div class="editorial-grid">
      <a class="editorial-card" href="/niigata/food/"
        ><div class="editorial-image">
          <img
            src="/images/niigata-food.webp"
            alt="新潟の日本酒が並ぶ棚"
            loading="lazy"
            width="1200"
            height="800"
          /><span>FOOD & DRINK</span>
        </div><div class="editorial-meta">
          <div>
            <h3>食を楽しむ</h3><p>料理人の背景から探す7店と、街の酒蔵。</p>
          </div><b aria-hidden="true">↗</b>
        </div></a
      >
      <a class="editorial-card" href="/niigata/housing/"
        ><div class="editorial-image">
          <img
            src="/images/niigata-housing.webp"
            alt="新潟の水辺とマンションのある街並み"
            loading="lazy"
            width="1200"
            height="800"
          /><span>FIND YOUR HOME</span>
        </div><div class="editorial-meta">
          <div>
            <h3>マンションを探す</h3><p>
              31住戸の観測記録を、価格と暮らしの条件で比較。
            </p>
          </div><b aria-hidden="true">↗</b>
        </div></a
      >
    </div>
  </section>
  <section class="map-feature">
    <div class="map-feature-copy">
      <p class="eyebrow">A CITY, CONNECTED</p><h2>
        好きな店と住まいを、<br />ひとつの地図に。
      </h2><p>
        マンション23建物、飲食店7店、酒蔵4軒。地図を動かして、普段の生活圏と休日の行き先を探せます。
      </p><a class="pill pill--dark" href="/niigata/map/"
        >地図で探す <span>↗</span></a
      >
    </div>
    <div class="map-preview">
      <iframe
        src="https://www.openstreetmap.org/export/embed.html?bbox=139.020%2C37.896%2C139.083%2C37.934&layer=mapnik"
        title="新潟駅・万代・古町の位置関係"
        loading="lazy"></iframe><a
        class="map-preview-label"
        href="/niigata/map/">34地点の生活地図を開く ↗</a
      >
    </div>
  </section>
  <section class="quiet-section shell">
    <p class="eyebrow">BEFORE YOU MOVE</p><div class="link-rows">
      <a class="link-row" href="/niigata/housing/#compare"
        ><span
          ><strong>自分の候補を比較する</strong><small
            >優先順位と月々の負担を整理。</small
          ></span
        ><span>↗</span></a
      ><a class="link-row" href="/niigata/relocation/"
        ><span
          ><strong>移住の準備をする</strong><small
            >仕事・支援制度・防災を確認。</small
          ></span
        ><span>↗</span></a
      >
    </div><p class="data-note">
      マンション・店舗情報は過去の観測記録です。確認日と出典を各ページに掲載しています。写真：Johnny、Pourya
      Gohari / Unsplash
    </p>
  </section>
  <div class="region-next shell">
    <p class="eyebrow">NEXT REGION / 次の街へ</p><a href="/hakodate/"
      >HAKODATE ↗</a
    >
  </div>
</BaseLayout>
